# Copy this file to .env and fill in only what you need.
#
# NOTE: normal use doesn't need any of this. Accounts are linked from the
# app itself with "Link account". This file exists for manual configuration
# or local development.

# --- Product mode -------------------------------------------------------
# customer = distributed build (default)
# personal = also shows the personal modules
APP_MODE=customer

# --- YouTube: manual configuration (optional) ----------------------------
# Format: YT_CHANNELS=name1:PREFIX1,name2:PREFIX2
YT_CHANNELS=
# NAME_YOUTUBE_CLIENT_ID=
# NAME_YOUTUBE_CLIENT_SECRET=
# NAME_YOUTUBE_REFRESH_TOKEN=
# Only if the token was created with a scope other than youtube.readonly:
# NAME_YOUTUBE_SCOPE=https://www.googleapis.com/auth/youtube.readonly

# --- Instagram: manual configuration (optional) --------------------------
# Format: IG_ACCOUNTS=name1:PREFIX1,name2:PREFIX2
IG_ACCOUNTS=
# NAME_IG_API=instagram        # "instagram" or "facebook"
# NAME_IG_ACCESS_TOKEN=
# NAME_IG_USER_ID=

# --- TikTok: manual configuration (optional) ------------------------------
# Format: TT_ACCOUNTS=name1:PREFIX1,name2:PREFIX2
TT_ACCOUNTS=
# NAME_TIKTOK_CLIENT_KEY=
# NAME_TIKTOK_CLIENT_SECRET=
# NAME_TIKTOK_REFRESH_TOKEN=

# --- X / Twitter -----------------------------------------------------------
# The free tier doesn't expose read metrics: this section stays
# informational even with credentials in place.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Personal modules (APP_MODE=personal) -----------------------------------
# CERTSPRINT_REPO_PATH=
# CERTSPRINT_PUBLIC_URL=
