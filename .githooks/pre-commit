#!/bin/sh
# Block commits that would add secrets to the repository.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# brand.py and .env are always local-only, even when they contain placeholders.

staged=$(git diff --cached --name-only)

# 1. Files that must never be tracked.
for f in brand.py .env; do
    if printf '%s\n' "$staged" | grep -qx "$f"; then
        echo "BLOCKED: $f may contain credentials and must not be committed."
        echo "  Remove it from the index with:  git restore --staged $f"
        exit 1
    fi
done

# 2. Values in staged content that look like live credentials.
#    Example files and comments are excluded because they contain placeholders.
#    An all-uppercase VARIABLE_NAME value is also treated as a mapping name.
#
#    Lowercase translation_keys without digits are excluded as well. Digits
#    deliberately remain suspicious so lowercase hexadecimal secrets are caught.
suspect=$(git diff --cached -U0 -- . ':(exclude)*example*' ':(exclude)*.md' \
    | grep '^+' \
    | grep -vE '^\+\s*(#|//|\*)' \
    | grep -inE '(APP_SECRET|CLIENT_SECRET|API_KEY|ACCESS_TOKEN|REFRESH_TOKEN|PASSWORD)[^=:]*[=:]\s*["'"'"'][A-Za-z0-9_/+-]{16,}["'"'"']' \
    | grep -vE '[=:]\s*["'"'"'][A-Z][A-Z0-9_]*["'"'"']' \
    | grep -vE '[=:]\s*["'"'"'][a-z]+(_[a-z]+)+["'"'"']')

if [ -n "$suspect" ]; then
    echo "BLOCKED: staged content appears to contain a live credential."
    echo "The matching value is intentionally hidden to keep it out of terminal and CI logs."
    echo "If this is a verified false positive, use:  git commit --no-verify"
    exit 1
fi

exit 0
