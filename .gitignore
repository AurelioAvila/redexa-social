# ---------------------------------------------------------------------
# Secrets and personal data - must NEVER reach the repository
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.env

# Local database: holds user accounts, sessions and the OAuth tokens of
# every connected account.
cache.db
*.db
*.sqlite
*.sqlite3

# OAuth credentials downloaded from the platforms' developer consoles
client_secret*.json
token.json
credentials.json
*.pem
*.key

# The product's own OAuth app credentials (Instagram/TikTok/Google) -
# compiled into the distributed executable, but NEVER into the public
# repository. The secret-free template is brand.example.py.
brand.py

# Wrangler's local state for the OAuth proxy (authenticated account, cache):
# personal to the machine, not part of the project.
oauth-proxy/.wrangler/
oauth-proxy/node_modules/
oauth-proxy/.dev.vars

# ---------------------------------------------------------------------
# Build artifacts
# ---------------------------------------------------------------------
build/
dist/
*.manifest
__pycache__/
*.py[cod]
*.egg-info/

# Zips of the compiled release (attached to GitHub Releases/SourceForge,
# never to the repository - an absent-minded `git add -A` must not be able
# to include them).
*.zip

# ---------------------------------------------------------------------
# Virtual environment
# ---------------------------------------------------------------------
venv/
.venv/
env/

# ---------------------------------------------------------------------
# Temporary and working files
# ---------------------------------------------------------------------
snap*.json
*.log
logs/
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# WebView2's local cache when the app runs from source in dev (desktop_app.py)
/webview/
